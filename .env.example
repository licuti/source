# Mẫu biến môi trường. Copy thành .env rồi chỉnh.
# File .env KHÔNG được commit (xem .gitignore).

# Database
DB_HOST=localhost
DB_NAME=phuongnamv_db
DB_USER=root
DB_PASS=
DB_PREFIX=db_

# Base URL tuyệt đối của site (không có dấu / cuối). Khuyên đặt khi chạy production.
# Bỏ trống để tự suy luận từ HTTP_HOST + HTTPS.
APP_URL=https://example.com

# Runtime migrations — mặc định TẮT. Chỉ bật tạm để dọn schema rồi tắt lại.
RUNTIME_MIGRATIONS=false

# JWT (HS256) — secret 256-bit (64 ký tự hex) dùng ký cookie keyId.
# Sinh mới: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=