# Mẫu biến môi trường. Copy thành .env rồi chỉnh.
# File .env KHÔNG được commit (xem .gitignore).

# Database
DB_HOST=localhost
DB_NAME=phuongnamv_db
DB_USER=root
DB_PASS=
DB_PREFIX=db_

# Base URL tuyệt đối của site (không có dấu / cuối). BẮT BUỘC — config.php không tự suy luận.
# Ở subfolder thì ghi luôn path con, ví dụ http://localhost/source
APP_URL=https://example.com

# Runtime migrations — mặc định TẮT. Chỉ bật tạm để dọn schema rồi tắt lại.
RUNTIME_MIGRATIONS=false

# JWT (HS256) — secret 256-bit (64 ký tự hex) dùng ký cookie keyId.
# Sinh mới: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# LMS password reset mail (SMTP sandbox recommended for local/test)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=MasterStudy
