RewriteEngine on

# ---- LMS MasterStudy: /lms/<portal>[/<alias>[/<action>]] (D10) ----
# PHẢI đặt TRƯỚC khối -d/-s bên dưới: lms/admin, lms/teacher, lms/student là
# thư mục thật (sources/templates) nên khối -d sẽ trả 403 nếu rule này nằm dưới.
# Pattern chỉ khớp 3 tên portal nên asset thật (lms/public/...) và file entry
# point (lms/admin.php) không bị ảnh hưởng. [QSA] giữ ?id=/?page=.
# Substitution BẮT BUỘC dùng path tuyệt đối (/lms/...): nếu dùng path tương đối
# (lms/$1.php) thì mod_dir's DirectorySlash sinh ra 301 dư cho /lms/admin (thư
# mục thật) → nhân đôi redirect. Path tuyệt đối → internal redirect thẳng.
RewriteRule ^lms/?$                                /lms/index.php [L]
RewriteRule ^lms/(admin|teacher|student)/?$        /lms/$1.php?lms_route=  [QSA,L]
RewriteRule ^lms/(admin|teacher|student)/(.+?)/?$  /lms/$1.php?lms_route=$2   [QSA,L]

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -s
RewriteRule ^.*$ - [L]


RewriteEngine on

# TEMP-PROBE
RewriteRule ^lmstest/(admin|teacher|student)/?$ /lms/$1.php?lms_route= [QSA,L]

# ---------------------------------------------------------------------------
# Chuyển hướng HTTP -> HTTPS (BẬT khi chạy production có SSL).
# Hiện đang phát triển ở local (không có HTTPS) nên TẠM COMMENT LẠI.
# Khi cần chạy, bỏ dấu # ở 3 dòng bên dưới.
# ---------------------------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]


Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

ErrorDocument 401 /index.php
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 500 /index.php

<files .htaccess> 
order allow,deny 
deny from all 
</files> 

<files config.php> 
order allow,deny 
deny from all 
</files> 

# Chặn truy cập file cấu hình / biến môi trường / migration
<files .env> 
order allow,deny 
deny from all 
</files> 

<files .env.example> 
order allow,deny 
deny from all 
</files> 

<files env.php>
order allow,deny
deny from all
</files>

<FilesMatch "(^\.env|\.sql$|\.log$)">
    Require all denied
</FilesMatch>

RewriteRule ^404/$ index.php?p=404 [L]
#url đa ngôn ngữ

RewriteRule ^([a-z]+)/$ index.php?com=&lang=$1 [QSA,L]
RewriteRule ^([a-z]+)/([a-zA-Z0-9_-]+).html$	index.php?lang=$1&com=$2 [QSA,L]
RewriteRule ^([a-z]+)/([a-zA-Z0-9_-]+).html&page=([0-9]+)$ index.php?lang=$1&com=$2&page=$3 [QSA,L]

#url một ngôn ngữ
RewriteRule ^([^/]*).html$	index.php?com=$1 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+).html&page=([0-9]+)$ index.php?com=$1&page=$2 [QSA,L]

RewriteRule ^([^/]*)/([^/]*).html$ index.php?alias=$1&com=$2 [QSA,L]
RewriteRule ^([^/]*)/([^/]*).html(.*)$ index.php?alias=$1&com=$2&page=$3 [QSA,L]

RewriteRule ^([^/]*)/([^/]*)/([^/]*).html$ index.php?alias=$1&alias1=$2&com=$3 [QSA,L]
RewriteRule ^([^/]*)/([^/]*)/([^/]*).html(.*)$ index.php?alias=$1&alias1=$2&com=$3&page=$4 [QSA,L]